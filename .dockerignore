# Files Docker does not send into the build.

# Secrets: they are passed at run time (env_file in compose.yaml), never baked into the image
.env

# Local environments, caches and the local index (the container builds its own)
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
chroma/

# Not needed to run the API
.git/
.github/
tests/
README.md
.DS_Store
